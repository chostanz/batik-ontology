        <berasalDari rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Kota_Semarang"/>
        <dibuatDenganTeknik rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Teknik_Tulis"/>
        <dipakaiPadaAcara rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Busana_Formal"/>
        <memilikiKegunaan rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Busana_Formal"/>
        <memilikiMotif rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Motif_Asem_Arang"/>
        <menggunakanBahanMalam rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Malam_Klowong"/>
        <menggunakanBahanMalam rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Malam_Tembokan"/>
        <aturanPemakaian>Tidak ada larangan khusus; disesuaikan dengan acara</aturanPemakaian>
        <bahanKain>Katun (mori)</bahanKain>
        <deskripsiBatik>Motif pohon asam dan daunnya, ikon batik Semarangan.</deskripsiBatik>
        <golonganPemakai>Masyarakat umum</golonganPemakai>
        <jenisKain>Kain panjang</jenisKain>
        <maknaFilosofis>Mengingatkan asal-usul nama Semarang dari pohon asam yang jarang (arang).</maknaFilosofis>
        <namaBatik>Asem Arang Semarang</namaBatik>
        <sejarahBatik>Terkait legenda asal nama Semarang dari &quot;asem arang&quot;.</sejarahBatik>
        <statusWarisanBudaya>Bagian dari Batik Indonesia, Warisan Budaya Takbenda UNESCO (ditetapkan 2 Oktober 2009)</statusWarisanBudaya>
        <sumberReferensi rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ich.unesco.org/en/RL/indonesian-batik-00170</sumberReferensi>
        <tingkatKerumitan>Sedang</tingkatKerumitan>
        <warnaDominan>Beragam</warnaDominan>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Batik_Asmat -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Batik_Asmat">
        <rdf:type rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#batik_tulis"/>
        <berasalDari rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Kab_Asmat"/>
        <dibuatDenganTeknik rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Teknik_Tulis"/>
        <dipakaiPadaAcara rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Busana_Formal"/>
        <dipakaiPadaAcara rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Cendera_Mata"/>
        <memilikiKegunaan rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Busana_Formal"/>
        <memilikiKegunaan rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Cendera_Mata"/>
        <memilikiMotif rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Motif_Ukiran_Asmat"/>
        <menggunakanBahanMalam rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Malam_Klowong"/>
        <menggunakanBahanMalam rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-3#Malam_Tembokan"/>
        <aturanPemakaian>Tidak ada larangan khusus; disesuaikan dengan acara</aturanPemakaian>
        <bahanKain>Katun (mori)</bahanKain>
        <deskripsiBatik>Batik Papua dengan motif yang diangkat dari ukiran suku Asmat.</deskripsiBatik>
        <golonganPemakai>Masyarakat umum</golonganPemakai>
        <jenisKain>Kain panjang</jenisKain>
